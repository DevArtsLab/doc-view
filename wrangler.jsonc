/**
 * ============================================================================
 * train-docs - markdown docs viewer behind Cloudflare Access
 * ============================================================================
 * train.devartslab.com -> Workers Static Assets
 *   /                -> viewers/<VIEWER>/index.html (plug-and-play shell)
 *   /content/**      -> synced markdown from ../train/
 * ============================================================================
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "train-docs",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],

  // run_worker_first: the Worker must see every request - it enforces the
  // private zone before assets are served.
  "assets": { "directory": "./public/", "binding": "ASSETS", "run_worker_first": true },

  "routes": [{ "pattern": "train.devartslab.com", "custom_domain": true }],

  "vars": {
    "DOCS_HOSTNAME": "train.devartslab.com",
    "VIEWER": "docsify",
    // Private zone (/content/private/**) fails closed until ACCESS_AUD is set
    // to the Access app's AUD tag.
    "ACCESS_TEAM_DOMAIN": "devartslab.cloudflareaccess.com",
    "ACCESS_AUD": "d0dde6dd6eb7f1312d55bccf81ec242b3e67b0fb7bb067df4be77f76be74dcec",
  },

  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
