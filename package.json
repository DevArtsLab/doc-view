{
  "name": "train-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown docs viewer for train/ content behind Cloudflare Access on train.devartslab.com",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "node scripts/sync.mjs && wrangler dev",
    "deploy": "node scripts/sync.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
